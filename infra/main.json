{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "5598096798249102373"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Use one your student subscription allows (Postgres Flexible Server capacity varies by region)."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "ptracker",
      "minLength": 3,
      "maxLength": 12,
      "metadata": {
        "description": "Short lowercase prefix for resource names."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "project": "saas-project-tracker",
        "environment": "prod"
      },
      "metadata": {
        "description": "Tags applied to every resource."
      }
    },
    "dbAdminUser": {
      "type": "string",
      "defaultValue": "ptadmin",
      "metadata": {
        "description": "PostgreSQL administrator login (not a reserved name such as admin/root)."
      }
    },
    "dbAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "PostgreSQL administrator password."
      }
    },
    "djangoSecretKey": {
      "type": "securestring",
      "metadata": {
        "description": "Django SECRET_KEY: long, random, unique to this environment."
      }
    },
    "dbName": {
      "type": "string",
      "defaultValue": "project_tracker",
      "metadata": {
        "description": "Application database name."
      }
    },
    "deployApps": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "false = platform only; true = also deploy the apps and migration job."
      }
    },
    "apiImageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Image tag of the API image (repository \"api\") in the registry."
      }
    },
    "webImageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Image tag of the web image (repository \"web\") in the registry."
      }
    },
    "apiMinReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "The API must stay warm: it holds the database connections and cold starts hurt."
      }
    },
    "webMinReplicas": {
      "type": "int",
      "defaultValue": 0,
      "metadata": {
        "description": "nginx starts in seconds, so scale-to-zero (0) is fine for a low-traffic student project."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 2
    },
    "logDailyCapGb": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Daily ingestion cap for Log Analytics, to protect student credit."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id)]",
    "acrName": "[format('{0}{1}', parameters('appName'), variables('suffix'))]",
    "pgName": "[format('{0}-pg-{1}', parameters('appName'), variables('suffix'))]",
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "apiSecrets": [
      {
        "name": "django-secret-key",
        "value": "[parameters('djangoSecretKey')]"
      },
      {
        "name": "db-password",
        "value": "[parameters('dbAdminPassword')]"
      }
    ],
    "identityBlock": {
      "type": "UserAssigned",
      "userAssignedIdentities": {
        "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))))]": {}
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('log-{0}', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "workspaceCapping": {
          "dailyQuotaGb": "[parameters('logDailyCapGb')]"
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('appi-{0}', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('appName')))]",
        "IngestionMode": "LogAnalytics"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('id-{0}', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), variables('acrPullRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('pgName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "[parameters('dbAdminUser')]",
        "administratorLoginPassword": "[parameters('dbAdminPassword')]",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Disabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        },
        "authConfig": {
          "activeDirectoryAuth": "Disabled",
          "passwordAuth": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('pgName'), parameters('dbName'))]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('pgName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('cae-{0}-wp', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('appName'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('appName'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('appName')))]"
      ]
    },
    {
      "condition": "[parameters('deployApps')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "api",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": "[variables('identityBlock')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": false,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": true
          },
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]"
            }
          ],
          "secrets": "[variables('apiSecrets')]"
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[format('{0}/api:{1}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer, parameters('apiImageTag'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "DJANGO_SECRET_KEY",
                  "secretRef": "django-secret-key"
                },
                {
                  "name": "DB_PASSWORD",
                  "secretRef": "db-password"
                },
                {
                  "name": "DB_HOST",
                  "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName')), '2024-08-01').fullyQualifiedDomainName]"
                },
                {
                  "name": "DB_NAME",
                  "value": "[parameters('dbName')]"
                },
                {
                  "name": "DB_USER",
                  "value": "[parameters('dbAdminUser')]"
                },
                {
                  "name": "DB_SSLMODE",
                  "value": "require"
                },
                {
                  "name": "DJANGO_ALLOWED_HOSTS",
                  "value": "api,.azurecontainerapps.io"
                },
                {
                  "name": "DJANGO_CSRF_TRUSTED_ORIGINS",
                  "value": "[format('https://{0}', format('web.{0}', reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName'))), '2024-03-01').defaultDomain))]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('appName'))), '2020-02-02').ConnectionString]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/api/healthz",
                    "port": 8000
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 15,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/api/readyz",
                    "port": 8000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('apiMinReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-concurrency",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]",
        "[resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('appName')))]",
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName'))]"
      ]
    },
    {
      "condition": "[parameters('deployApps')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "web",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": "[variables('identityBlock')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false
          },
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "web",
              "image": "[format('{0}/web:{1}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer, parameters('webImageTag'))]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "API_UPSTREAM",
                  "value": "http://api"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 15
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('webMinReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-concurrency",
                "http": {
                  "metadata": {
                    "concurrentRequests": "100"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.App/containerApps', 'api')]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]",
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName')))]"
      ]
    },
    {
      "condition": "[parameters('deployApps')]",
      "type": "Microsoft.App/jobs",
      "apiVersion": "2024-03-01",
      "name": "migrate",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": "[variables('identityBlock')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName')))]",
        "configuration": {
          "triggerType": "Manual",
          "replicaTimeout": 600,
          "replicaRetryLimit": 0,
          "manualTriggerConfig": {
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]"
            }
          ],
          "secrets": "[variables('apiSecrets')]"
        },
        "template": {
          "containers": [
            {
              "name": "migrate",
              "image": "[format('{0}/api:{1}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer, parameters('apiImageTag'))]",
              "command": [
                "sh",
                "-c"
              ],
              "args": [
                "python manage.py migrate --noinput && python manage.py createcachetable"
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "DJANGO_SECRET_KEY",
                  "secretRef": "django-secret-key"
                },
                {
                  "name": "DB_PASSWORD",
                  "secretRef": "db-password"
                },
                {
                  "name": "DB_HOST",
                  "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName')), '2024-08-01').fullyQualifiedDomainName]"
                },
                {
                  "name": "DB_NAME",
                  "value": "[parameters('dbName')]"
                },
                {
                  "name": "DB_USER",
                  "value": "[parameters('dbAdminUser')]"
                },
                {
                  "name": "DB_SSLMODE",
                  "value": "require"
                },
                {
                  "name": "DJANGO_ALLOWED_HOSTS",
                  "value": "api,.azurecontainerapps.io"
                },
                {
                  "name": "DJANGO_CSRF_TRUSTED_ORIGINS",
                  "value": "[format('https://{0}', format('web.{0}', reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName'))), '2024-03-01').defaultDomain))]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('appName'))), '2020-02-02').ConnectionString]"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]",
        "[resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('appName')))]",
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName'))]"
      ]
    }
  ],
  "outputs": {
    "webUrl": {
      "type": "string",
      "value": "[format('https://{0}', format('web.{0}', reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-wp', parameters('appName'))), '2024-03-01').defaultDomain))]"
    },
    "acrName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
    },
    "postgresHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName')), '2024-08-01').fullyQualifiedDomainName]"
    },
    "environmentName": {
      "type": "string",
      "value": "[format('cae-{0}-wp', parameters('appName'))]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[format('log-{0}', parameters('appName'))]"
    },
    "appInsightsName": {
      "type": "string",
      "value": "[format('appi-{0}', parameters('appName'))]"
    }
  }
}